# Copy to .env (git-ignored) or run `make env` to derive it from test-cred.
# Every setting is a HIVE_* variable; see backend/hive/config.py for the full
# list and defaults. Values below are the rctest development defaults.
HIVE_ENV=dev
HIVE_PUBLIC_URL=http://localhost:5173
HIVE_COOKIE_SECURE=false
HIVE_DOCS_ENABLED=true
HIVE_LOG_FORMAT=console

# Keystone (public endpoint is fine for development)
HIVE_KEYSTONE_URL=https://identity.rctest.nectar.org.au/v3
HIVE_REGION=Melbourne

# manuka (accounts) on rctest
HIVE_LOGIN_URL=https://accounts.test.rc.nectar.org.au/login
HIVE_LOGIN_URL_NZ=https://accounts.test.rc.nectar.org.au/Shibboleth.sso/DS-Tuakiri?return-path=/login/
HIVE_WEBSSO_ALLOWED_ORIGINS=https://accounts.test.rc.nectar.org.au,http://127.0.0.1:8765,http://localhost:8765

# Sessions and caches
HIVE_REDIS_URL=redis://localhost:6379/0
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
HIVE_SECRET_KEY=change-me-to-a-long-random-string

# Links
HIVE_HORIZON_URL=https://dashboard.rctest.nectar.org.au
HIVE_ALLOCATION_API_URL=https://dashboard.rctest.nectar.org.au/rest_api
HIVE_OUTAGE_BASE_URL=https://status.rctest.nectar.org.au/outages/
HIVE_HELP_URL=https://support.ehelp.edu.au/support/home

# Roles (rctest ids from argocd-apps-test/apps-artm/dashboard-next.yaml)
HIVE_ROLE_MEMBER_ID=
HIVE_ROLE_TENANTMANAGER_ID=

# Account panels (rctest values from argocd-apps-test/apps-artm/dashboard-next.yaml)
HIVE_ORCID_URL=https://sandbox.orcid.org
HIVE_ORCID_LINK_URL=
HIVE_ORCID_UNLINK_URL=
# The shared "original password" Horizon's reset password view uses (Vault)
HIVE_PASSWORD_RESET_TOKEN=
HIVE_PASSWORD_RESET_DELAY=5
HIVE_APP_CREDENTIAL_EXPIRY_MONTHS=3
HIVE_USAGE_DATA_FROM=2022-01-01
# Shares: Manila API microversion and the protocols offered on create.
HIVE_MANILA_MICROVERSION=2.65
HIVE_MANILA_SHARE_PROTOCOLS=NFS,CIFS,CephFS
