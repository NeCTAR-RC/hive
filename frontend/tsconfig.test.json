{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "node"]
  },
  /* Unit tests, their setup, the mocked API and the end-to-end specs: the
     app config leaves them out, and Vitest and Playwright only strip types.
     The agency elements' JSX typing comes along for tests that reach the
     layouts, which nothing imports it into. */
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test",
    "src/mocks",
    "src/ardc-elements.d.ts",
    "e2e"
  ],
  /* The app config excludes the tests; an empty list here overrides it,
     since a child config inherits the parent's exclude when it sets none. */
  "exclude": []
}
